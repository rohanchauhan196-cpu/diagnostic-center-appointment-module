# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Local development (direct execution):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diagnostic_center?schema=public"
# Docker Compose:
# Note: Inside Docker, the database URL defaults to using host 'postgres'
# (this is overridden dynamically in docker-compose.yml).

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a long random secret for production deployments
# You can run `openssl rand -base64 32` to generate one.
JWT_SECRET="generate-a-proper-secure-secret-key-here"
JWT_EXPIRES_IN="8h"

# -----------------------------------------------------------------------------
# PORT CONFIGURATION (Used inside Docker / local dev)
# -----------------------------------------------------------------------------
API_PORT=4000

# -----------------------------------------------------------------------------
# FRONTEND API CONFIGURATION (Next.js)
# -----------------------------------------------------------------------------
# For local dev and standard docker-compose, these can remain pointing to localhost.
# The app will dynamically fall back to same-origin path /api and socket routing
# when accessed in production on other hosts (like custom domains or public IPs).
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
